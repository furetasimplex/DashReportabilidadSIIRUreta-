+class Motor(_Motor):
+    @contextmanager
+    def connect(self):
+        self.conexiones += 1
+        try:
+            yield self.conn
+        finally:
+            assert not self.conn.mensual or self.conn.invalidada
+            self.conn.eventos.append('pool')
