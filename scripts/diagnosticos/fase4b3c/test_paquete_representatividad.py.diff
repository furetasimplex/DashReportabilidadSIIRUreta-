+@pytest.mark.parametrize('fail', range(1,9))
+def test_cualquier_fetch_revierte_y_no_workbook(fail):
+    h = Harness(fail)
+    with h.patched(), patch.object(cb, '_export_representatividad_desde_paquete') as builder:
+        with pytest.raises(RuntimeError, match='fetch deliberado'):
+            cb._construir_fuente_unica_representatividad(date(2026,9,1),date(2026,9,30))
+    builder.assert_not_called()
+    assert not h.conn.confirmados
