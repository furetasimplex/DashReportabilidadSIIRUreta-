+@pytest.mark.parametrize('editor', [False,True])
+def test_paquetes_locks_conn_rangos_y_release(editor):
+    h = Harness()
+    with h.patched():
+        p = (repo.preparar_paquete_editor_representatividad(date(2026,9,7),date(2026,9,30),periodo_mes='2026-09')
+             if editor else repo.armar_paquete_reporte_torre_oficial(date(2026,9,1),date(2026,9,30)))
+    assert h.motor.conexiones == 1
+    assert h.conn.eventos[-4:] == ['commit','release','control_commit','pool']
+    assert len(h.reads) == (5 if editor else 8)
+    for name, a, kw in h.reads:
+        if 'end_date' in kw:
+            assert kw['end_date'] == date(2026,9,11 if name == FETCHES[3] else 10)
+        if name == FETCHES[4]:
+            assert kw['fecha_corte'] == date(2026,9,10)
+            assert kw['objetivo'] == .85
+    assert p['comentarios'].empty
+    if not editor:
+        assert len(p['rep_torres']) == 30
+        assert h.reads[2][2]['start_date'] == date(2026,7,1)
+    assert not h.conn.tx and not h.conn.mensual and not h.conn.global_lock
+
