+@pytest.mark.parametrize('name', FETCHES + ('fetch_comentarios_representatividad_periodo',))
+def test_fetch_externo_y_standalone(name):
+    conn=MagicMock(spec=Connection)
+    engine=MagicMock(spec=Engine)
+    calls=[]
+    def read(sql, actual, **kw):
+        calls.append((str(sql),actual,kw))
+        return pd.DataFrame(columns=['Fecha','Dia','SRR_TurnoA_Quimico','SRR_TurnoA_Fisico',
+                                     'SRR_TurnoB_Quimico','SRR_TurnoB_Fisico'])
+    kwargs=({'periodo_inicio':date(2026,9,1),'periodo_fin':date(2026,9,30)} if name=='fetch_comentarios_representatividad_periodo' else
+            {'anio_fiscal':2027,'tipo':'QUIMICO'} if name==FETCHES[4] else
+            {'periodo_mes':'2026-09'} if name==FETCHES[5] else
+            {'start_date':date(2026,9,1),'end_date':date(2026,9,10)})
+    with patch.object(repo,'_get_engine',return_value=engine) as get, \
+         patch('db_connection.get_engine',return_value=engine) as get2, \
+         patch.object(repo.pd,'read_sql',side_effect=read),patch.object(repo.pd,'read_sql_query',side_effect=read):
+        a=getattr(repo,name)(**kwargs,conn=conn)
+        get.assert_not_called();get2.assert_not_called()
+        assert not conn.method_calls
+        b=getattr(repo,name)(**kwargs)
+    pd.testing.assert_frame_equal(a,b)
+    assert calls[0][1] is conn
+    assert calls[0][0]==calls[1][0] and calls[0][2]==calls[1][2]
+
