+def test_release_incierto_invalida_antes_pool():
+    h=Harness()
+    original=h.conn.execute
+    def execute(sql,params=None):
+        if "SELECT APPLOCK_MODE('public', :recurso, 'Session')" in str(sql):
+            return _Result('Exclusive')
+        return original(sql,params)
+    h.conn.execute=execute
+    with h.patched(),pytest.raises(RuntimeError,match='liberar el lock mensual'):
+        repo.armar_paquete_reporte_torre_oficial(date(2026,9,1),date(2026,9,30))
+    assert h.conn.invalidada and h.conn.eventos[-1]=='pool'
+
