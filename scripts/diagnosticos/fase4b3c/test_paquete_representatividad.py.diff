+"""Prepare/read F4B3C con owner F4C real y conexiones simuladas."""
+from contextlib import contextmanager, ExitStack
+from datetime import date
+from types import SimpleNamespace
+from unittest.mock import MagicMock, patch
+
+import pandas as pd
+import pytest
+from sqlalchemy.engine import Connection, Engine
+
+from report_export import report_export as repo
+from report_export.callbacks import reportabilidad_cb as cb
+from report_export.tests.test_refresco_representatividad import _Conexion, _Motor, _Result
+
+FETCHES = ('fetch_representatividad_torres_report', 'fetch_pesos_representatividad_report',
+           'fetch_bd_ton_report', 'fetch_estado_apilado_turno_representatividad',
+           'fetch_gestion_representatividad_fy', 'fetch_reporte_torre_oficial_detalle')
+
+
+class Motor(_Motor):
+    @contextmanager
+    def connect(self):
+        self.conexiones += 1
+        try:
+            yield self.conn
+        finally:
+            assert not self.conn.mensual or self.conn.invalidada
+            self.conn.eventos.append('pool')
+
+
+class Harness:
+    def __init__(self, fail=None):
+        self.conn = _Conexion()
+        self.motor = Motor(self.conn)
+        self.reads = []
+        self.fail = fail
+
+    def rto(self, **kw):
+        assert kw['conn'] is self.conn and self.conn.tx == 1 and self.conn.mensual
+        repo._adquirir_lock_refresco_turno(self.conn)
+        self.conn.pendientes.append('RTO')
+        return {'fecha_corte_operacional': date(2026,9,10)}
+
+    def read(self, name, *a, **kw):
+        assert kw['conn'] is self.conn
+        assert self.conn.tx == 1 and self.conn.global_lock and self.conn.mensual
+        self.reads.append((name,a,kw))
+        self.conn.eventos.append(name)
+        if len(self.reads) == self.fail:
+            raise RuntimeError('fetch deliberado')
+        if name == FETCHES[-1]:
+            return pd.DataFrame()
+        return pd.DataFrame({'Fecha':[pd.Timestamp('2026-09-10')],
+                             'Dia':[pd.Timestamp('2026-09-10')]})
+
+    @contextmanager
+    def patched(self):
+        with ExitStack() as stack:
+            stack.enter_context(patch.object(repo, '_get_engine', return_value=self.motor))
+            stack.enter_context(patch.object(repo, 'fetch_fecha_corte_operacional_representatividad', return_value=date(2026,9,10)))
+            stack.enter_context(patch.object(repo, 'refrescar_dependencias_reporte_turno_emision', self.rto))
+            for name in FETCHES:
+                stack.enter_context(patch.object(repo, name, lambda *a, _name=name, **kw: self.read(_name,*a,**kw)))
+            yield
+
