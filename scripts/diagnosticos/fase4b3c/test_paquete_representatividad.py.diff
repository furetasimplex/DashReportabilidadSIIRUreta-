+def test_script_manual_safe_no_importa_sql(capsys):
+    import importlib.util
+    import sys
+    from pathlib import Path
+    path=Path(repo.__file__).parents[1]/'scripts/validate_export_representatividad_read_coherence_dev.py'
+    spec=importlib.util.spec_from_file_location('manual_rep',path)
+    module=importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    with patch.dict(sys.modules,{'sqlalchemy':None,'monitor_pi_tum.db':None,'report_export.report_export':None}):
+        assert module.main([])==0
+    assert capsys.readouterr().out.strip()=='SAFE: no se conecta ni escribe. Requiere --execute-rollback.'
+
