+@pytest.mark.parametrize('tipo', ['excel','quimico','fisico','srr'])
+def test_excel_pdf_fuera_de_sql(tipo):
+    h=Harness()
+    def outside(*a, **kw):
+        assert not h.conn.tx and not h.conn.mensual and not h.conn.global_lock
+        assert h.conn.eventos[-1] == 'pool'
+        return b'workbook'
+    def pdf(*a, **kw):
+        outside()
+        return b'pdf','archivo.pdf'
+    with h.patched(), patch.object(cb, '_export_representatividad_desde_paquete',side_effect=outside) as excel, \
+         patch.object(cb, '_validar_workbook_representatividad',return_value={t:{'filas_detalle':2} for t in ('quimico','fisico','srr')}), \
+         patch.object(cb, '_pdf_representatividad_desde_xlsx',side_effect=pdf) as render, \
+         patch.object(cb, '_enviar_descarga',return_value='descarga'), \
+         patch.object(cb, 'ctx',SimpleNamespace(triggered_id={'tipo':'representatividad_torres_'+tipo})):
+        if tipo == 'excel':
+            assert cb._generar_excel_representatividad_completo(date(2026,9,1),date(2026,9,30)) == b'workbook'
+        else:
+            result=cb.generar_pdf([1],'2026-09-01','2026-09-30')
+            assert result[0] == 'descarga'
+            render.assert_called_once()
+    excel.assert_called_once()
