"""Contratos de fechas, secuencia y frescura; sin conexiones SQL reales."""
import ast
from datetime import date, datetime, timedelta
from pathlib import Path
import unittest
from unittest.mock import MagicMock, patch
from contextlib import contextmanager

from report_export import report_export as repo


PASOS = ["sp_mantiene_apilado_tmh_v2_test", "sp_refrescar_historico_apilado_test",
         "sp_mantiene_factor_ajuste_camiones_v2_test", "sp_refrescar_clays_cufe",
         "sp_actualizar_reporte_turno_cache_emision_test"]


def motor_simulado(falla=None, lock_rc=0):
    """Wrappers reales sobre una transacción simulada, sin acceso a SQL."""
    engine, conn = MagicMock(), MagicMock()
    eventos, confirmados, pendientes = [], [], []
    momento, dia = datetime(2026, 9, 19), date(2026, 9, 10)

    def ejecutar(sql, params=None):
        sql = str(sql)
        result = MagicMock()
        if 'sp_getapplock' in sql:
            eventos.append('lock')
            if falla == 'lock_sql':
                raise RuntimeError('fallo lock SQL')
            result.scalar.return_value = lock_rc
        elif 'SELECT MAX(fecha_operacional)' in sql:
            eventos.append('corte')
            result.scalar.return_value = dia
        elif 'SELECT SYSDATETIME()' in sql:
            result.scalar.return_value = momento
        elif any(p in sql for p in PASOS):
            paso = next(p for p in PASOS if p in sql)
            eventos.append(paso)
            if falla == paso:
                raise RuntimeError('fallo ' + paso)
            pendientes.append(paso)
        elif 'Control_Apilado_TMH_v2_test' in sql:
            result.mappings.return_value.all.return_value = [{'Fecha': dia, 'Fecha_Calculo': momento}]
        elif 'reporte_turno_cache_emision_test' in sql:
            eventos.append('validacion')
            result.mappings.return_value.all.return_value = [] if falla == 'validacion' else [
                {'Fecha': dia, 'Turno': t, 'Fecha_Actualizacion': momento} for t in ('A', 'B')]
        else:
            raise AssertionError(sql)
        return result

    conn.execute.side_effect = ejecutar

    @contextmanager
    def transaccion():
        eventos.append('begin')
        try:
            yield conn
        except Exception:
            eventos.append('rollback')
            pendientes.clear()
            raise
        else:
            eventos.append('commit')
            confirmados.extend(pendientes)

    engine.begin.side_effect = transaccion
    return engine, conn, eventos, confirmados


class OrquestacionTurnoTests(unittest.TestCase):
    def test_periodos_y_orden(self):
        casos = [
            (date(2026, 9, 1), date(2026, 9, 30), date(2026, 9, 13), date(2026, 9, 7)),
            (date(2026, 8, 1), date(2026, 8, 31), date(2026, 8, 31), date(2026, 8, 25)),
            (date(2026, 9, 5), date(2026, 9, 10), date(2026, 9, 10), date(2026, 9, 5)),
            (date(2026, 9, 1), date(2026, 9, 30), date(2026, 9, 10), date(2026, 9, 4)),
        ]
        for inicio, fin, corte, ventana in casos:
            with self.subTest(corte=corte, inicio=inicio):
                momento = datetime(2026, 10, 1)
                engine = MagicMock()
                conn = engine.begin.return_value.__enter__.return_value
                conn.execute.return_value.scalar.side_effect = [0, momento]
                conn.execute.return_value.mappings.return_value.all.side_effect = [
                    [{"Fecha": ventana + timedelta(days=i), "Fecha_Calculo": momento}
                     for i in range((corte - ventana).days + 1)],
                    [{"Fecha": corte, "Turno": t, "Fecha_Actualizacion": momento} for t in ("A", "B")],
                ]
                llamadas = []
                def registrar(nombre):
                    return lambda *a, **kw: llamadas.append((nombre, a, kw))
                with patch.object(repo, "_get_engine", return_value=engine), \
                     patch.object(repo, "fetch_fecha_corte_apilado_tmh_report", return_value=corte), \
                     patch.object(repo, "actualizar_apilado_tmh_v2_report", side_effect=registrar("apilado")), \
                     patch.object(repo, "refrescar_historico_apilado_report", side_effect=registrar("historico")), \
                     patch.object(repo, "actualizar_factor_ajuste_camiones_v2_report", side_effect=registrar("factor")), \
                     patch.object(repo, "actualizar_reporte_turno_cache_emision", side_effect=registrar("cache")):
                    resultado = repo.refrescar_dependencias_reporte_turno_emision(inicio, fin)
                self.assertEqual(resultado["inicio_ventana"], ventana)
                self.assertEqual(resultado["fin_solicitada"], fin)
                self.assertEqual(llamadas, [
                    ("apilado", (inicio, corte, 7), {"conn": conn}),
                    ("historico", (ventana, corte), {"dias_reproceso": 0, "conn": conn}),
                    ("factor", (inicio, corte), {"dias_reproceso": 0, "conn": conn}),
                    ("cache", (inicio, corte + timedelta(days=1)), {"conn": conn}),
                ])
                engine.begin.assert_called_once_with()
                engine.connect.assert_not_called()
                self.assertEqual(resultado["fin_sql_exclusivo"], corte + timedelta(days=1))

    def test_historico_incluye_faltantes_antiguos_sin_ampliar_huecos(self):
        momento = datetime(2026, 9, 19)
        engine = MagicMock()
        conn = engine.begin.return_value.__enter__.return_value
        conn.execute.return_value.scalar.side_effect = [0, momento]
        conn.execute.return_value.mappings.return_value.all.side_effect = [
            [{"Fecha": date(2026, 9, d), "Fecha_Calculo": momento if d in (1, 9, 10)
              else momento - timedelta(days=1)} for d in (1, 2, 9, 10)],
            [{"Fecha": date(2026, 9, 10), "Turno": t, "Fecha_Actualizacion": momento} for t in ("A", "B")],
        ]
        with patch.object(repo, "_get_engine", return_value=engine), \
             patch.object(repo, "fetch_fecha_corte_apilado_tmh_report", return_value=date(2026, 9, 10)), \
             patch.object(repo, "actualizar_apilado_tmh_v2_report"), \
             patch.object(repo, "refrescar_historico_apilado_report") as historico, \
             patch.object(repo, "actualizar_factor_ajuste_camiones_v2_report"), \
             patch.object(repo, "actualizar_reporte_turno_cache_emision"):
            repo.refrescar_dependencias_reporte_turno_emision(date(2026, 9, 1), date(2026, 9, 10), 2)
        self.assertEqual([(c.args, c.kwargs) for c in historico.call_args_list], [
            ((date(2026, 9, 1), date(2026, 9, 1)), {"dias_reproceso": 0, "conn": conn}),
            ((date(2026, 9, 9), date(2026, 9, 10)), {"dias_reproceso": 0, "conn": conn}),
        ])

    def test_una_conexion_lock_orden_y_commit_despues_de_validar(self):
        engine, conn, eventos, confirmados = motor_simulado()
        with patch.object(repo, '_get_engine', return_value=engine):
            repo.refrescar_dependencias_reporte_turno_emision(date(2026, 9, 10), date(2026, 9, 10))
        self.assertEqual(eventos, ['begin', 'lock', 'corte'] + PASOS + ['validacion', 'commit'])
        self.assertEqual(confirmados, PASOS)
        engine.begin.assert_called_once_with()
        engine.connect.assert_not_called()
        conn.begin.assert_not_called()
        conn.commit.assert_not_called()
        conn.rollback.assert_not_called()
        sql_lock = str(conn.execute.call_args_list[0].args[0])
        for fragmento in ("@Resource='SIIR_CONTINGENCIA_PI_APILADO_DEV'", "@LockMode='Exclusive'",
                          "@LockOwner='Transaction'", '@LockTimeout=10000'):
            self.assertIn(fragmento, sql_lock)

    def test_fallo_cualquier_etapa_revierte_todo_y_detiene_downstream(self):
        for falla in PASOS + ['validacion']:
            with self.subTest(falla=falla):
                engine, conn, eventos, confirmados = motor_simulado(falla=falla)
                with patch.object(repo, '_get_engine', return_value=engine):
                    with self.assertRaises(RuntimeError):
                        repo.refrescar_dependencias_reporte_turno_emision(date(2026, 9, 10), date(2026, 9, 10))
                ejecutados = PASOS if falla == 'validacion' else PASOS[:PASOS.index(falla) + 1]
                self.assertEqual([e for e in eventos if e in PASOS], ejecutados)
                self.assertEqual(eventos[-1], 'rollback')
                self.assertNotIn('commit', eventos)
                self.assertEqual(confirmados, [])
                engine.begin.assert_called_once()
                engine.connect.assert_not_called()

    def test_lock_fallido_no_lee_corte_ni_ejecuta_mantenedores(self):
        for rc in (-1, -2, -3, -999, None):
            with self.subTest(rc=rc):
                engine, conn, eventos, confirmados = motor_simulado(lock_rc=rc)
                with patch.object(repo, '_get_engine', return_value=engine):
                    with self.assertRaisesRegex(RuntimeError, 'bloqueo PI/TUM'):
                        repo.refrescar_dependencias_reporte_turno_emision(date(2026, 9, 10), date(2026, 9, 10))
                self.assertEqual(eventos, ['begin', 'lock', 'rollback'])
                self.assertEqual(confirmados, [])
                conn.execute.assert_called_once()

    def test_error_sql_lock_no_se_oculta(self):
        engine, conn, eventos, _ = motor_simulado(falla='lock_sql')
        with patch.object(repo, '_get_engine', return_value=engine):
            with self.assertRaisesRegex(RuntimeError, 'fallo lock SQL'):
                repo.refrescar_dependencias_reporte_turno_emision(date(2026, 9, 10), date(2026, 9, 10))
        self.assertEqual(eventos, ['begin', 'lock', 'rollback'])

    def test_wrappers_standalone_y_conexion_externa(self):
        for nombre, cantidad in [('actualizar_apilado_tmh_v2_report', 1),
                                 ('refrescar_historico_apilado_report', 1),
                                 ('actualizar_factor_ajuste_camiones_v2_report', 1),
                                 ('actualizar_reporte_turno_cache_emision', 2)]:
            with self.subTest(wrapper=nombre):
                engine, externo = MagicMock(), MagicMock()
                fn = getattr(repo, nombre)
                with patch.object(repo, '_get_engine', return_value=engine) as get_engine:
                    fn(date(2026, 9, 4), date(2026, 9, 10), conn=externo)
                    get_engine.assert_not_called()
                    self.assertEqual(externo.execute.call_count, cantidad)
                    externo.begin.assert_not_called()
                    externo.commit.assert_not_called()
                    fn(date(2026, 9, 4), date(2026, 9, 10))
                self.assertEqual(engine.begin.call_count, cantidad)

    def test_corte_consulta_conexion_externa_o_standalone(self):
        engine, externo = MagicMock(), MagicMock()
        externo.execute.return_value.scalar.return_value = date(2026, 9, 10)
        engine.connect.return_value.__enter__.return_value.execute.return_value.scalar.return_value = date(2026, 9, 10)
        with patch.object(repo, '_get_engine', return_value=engine) as get_engine:
            self.assertEqual(repo.fetch_fecha_corte_apilado_tmh_report(
                date(2026, 9, 1), date(2026, 9, 30), conn=externo), date(2026, 9, 10))
            get_engine.assert_not_called()
            self.assertEqual(repo.fetch_fecha_corte_apilado_tmh_report(
                date(2026, 9, 1), date(2026, 9, 30)), date(2026, 9, 10))
        engine.connect.assert_called_once_with()
        engine.begin.assert_not_called()

    def test_clays_conserva_corte_agosto_y_cache_semiabierto(self):
        for inicio, fin, esperado_clays in [
            (date(2026, 7, 1), date(2026, 8, 1), None),
            (date(2026, 7, 30), date(2026, 8, 3), (date(2026, 8, 1), date(2026, 8, 2))),
        ]:
            with self.subTest(inicio=inicio, fin=fin):
                conn = MagicMock()
                with patch.object(repo, '_get_engine', side_effect=AssertionError('conexión adicional')):
                    repo.actualizar_reporte_turno_cache_emision(inicio, fin, conn=conn)
                llamadas = conn.execute.call_args_list
                self.assertEqual(len(llamadas), 2 if esperado_clays else 1)
                if esperado_clays:
                    self.assertEqual(llamadas[0].args[1], {
                        'fecha_inicio': esperado_clays[0], 'fecha_fin': esperado_clays[1]})
                self.assertEqual(llamadas[-1].args[1], {'fecha_inicio': inicio, 'fecha_fin': fin})

    def test_sin_corte_no_escribe(self):
        engine = MagicMock()
        engine.begin.return_value.__enter__.return_value.execute.return_value.scalar.return_value = 0
        with patch.object(repo, "_get_engine", return_value=engine), \
             patch.object(repo, "fetch_fecha_corte_apilado_tmh_report", return_value=None), \
             patch.object(repo, "actualizar_apilado_tmh_v2_report") as apilado:
            with self.assertRaisesRegex(RuntimeError, "No existe una fecha operacional"):
                repo.refrescar_dependencias_reporte_turno_emision(date(2026, 9, 1), date(2026, 9, 30))
            apilado.assert_not_called()

    def test_apilado_no_actualizado_detiene_antes_de_historico(self):
        momento = datetime(2026, 9, 19)
        engine = MagicMock()
        conn = engine.begin.return_value.__enter__.return_value
        conn.execute.return_value.scalar.side_effect = [0, momento]
        conn.execute.return_value.mappings.return_value.all.return_value = [
            {"Fecha": date(2026, 9, 10), "Fecha_Calculo": momento - timedelta(days=1)}]
        with patch.object(repo, "_get_engine", return_value=engine), \
             patch.object(repo, "fetch_fecha_corte_apilado_tmh_report", return_value=date(2026, 9, 10)), \
             patch.object(repo, "actualizar_apilado_tmh_v2_report"), \
             patch.object(repo, "refrescar_historico_apilado_report") as historico, \
             patch.object(repo, "actualizar_factor_ajuste_camiones_v2_report") as factor:
            with self.assertRaisesRegex(RuntimeError, "filas obsoletas"):
                repo.refrescar_dependencias_reporte_turno_emision(date(2026, 9, 10), date(2026, 9, 10))
        historico.assert_not_called()
        factor.assert_not_called()

    def test_historico_rango_explicito_sin_ampliacion(self):
        engine = MagicMock()
        with patch.object(repo, "_get_engine", return_value=engine):
            repo.refrescar_historico_apilado_report(date(2026, 9, 4), date(2026, 9, 10), dias_reproceso=0)
        call = engine.begin.return_value.__enter__.return_value.execute.call_args
        self.assertIn("sp_refrescar_historico_apilado_test", str(call.args[0]))
        self.assertEqual(call.args[1], {"fecha_inicio": date(2026, 9, 4),
                                      "fecha_fin": date(2026, 9, 10), "dias_reproceso": 0})

    def test_cache_incompleto_obsoleto_y_duplicado(self):
        corte = date(2026, 9, 13)
        momento = datetime(2026, 9, 14)
        filas = [{"Fecha": corte, "Turno": t, "Fecha_Actualizacion": momento} for t in ("A", "B")]
        args = (date(2026, 9, 1), date(2026, 10, 1), corte, momento)
        repo._validar_frescura_cache_turno(filas, *args)
        for invalido in ([], filas[:1], filas + filas[:1],
                         [dict(f, Fecha_Actualizacion=momento - timedelta(seconds=1)) for f in filas]):
            with self.subTest(filas=invalido), self.assertRaises(RuntimeError):
                repo._validar_frescura_cache_turno(invalido, *args)

    def test_clays_precede_cache_y_respeta_fin_exclusivo(self):
        engine = MagicMock()
        conn = engine.begin.return_value.__enter__.return_value
        with patch.object(repo, "_get_engine", return_value=engine):
            repo.actualizar_reporte_turno_cache_emision(date(2026, 9, 1), date(2026, 10, 1))
        llamadas = conn.execute.call_args_list
        self.assertEqual(len(llamadas), 2)
        self.assertIn("sp_refrescar_clays_cufe", str(llamadas[0].args[0]))
        self.assertEqual(llamadas[0].args[1]["fecha_fin"], date(2026, 9, 30))
        self.assertIn("sp_actualizar_reporte_turno_cache", str(llamadas[1].args[0]))
        self.assertEqual(llamadas[1].args[1]["fecha_fin"], date(2026, 10, 1))

    def test_consumidores_comparten_orquestacion(self):
        path = Path(repo.__file__).parent / "callbacks/reportabilidad_cb.py"
        tree = ast.parse(path.read_text(encoding="utf-8"))
        consumidores = []
        for fn in tree.body:
            if not isinstance(fn, ast.FunctionDef):
                continue
            calls = [n.func.id for n in ast.walk(fn) if isinstance(n, ast.Call) and isinstance(n.func, ast.Name)]
            if "preparar_paquete_reporte_turno_emision" in calls:
                consumidores.append(fn.name)
                self.assertNotIn("actualizar_apilado_tmh_v2_report", calls)
                self.assertNotIn("actualizar_factor_ajuste_camiones_v2_report", calls)
                fetches = [n for n in ast.walk(fn) if isinstance(n, ast.Call)
                           and isinstance(n.func, ast.Name) and n.func.id == "fetch_reporte_turno_cache_emision"]
                for fetch in fetches:
                    end = next(k.value for k in fetch.keywords if k.arg == "end_date")
                    self.assertEqual(ast.unparse(end), "refresco_turno['fin_sql_exclusivo']")
        self.assertIn("generar_reporte", consumidores)
        self.assertIn("exportar_excel", consumidores)
        self.assertIn("generar_pdf", consumidores)
        self.assertEqual(set(consumidores), {"generar_reporte", "exportar_excel", "generar_pdf"})
        helper_dc = next(n for n in tree.body if isinstance(n, ast.FunctionDef)
                         and n.name == "_refrescar_dependencias_datos_conciliados")
        self.assertTrue(any(isinstance(n, ast.Call) and isinstance(n.func, ast.Name)
                            and n.func.id == "refrescar_dependencias_datos_conciliados_emision"
                            for n in ast.walk(helper_dc)))


if __name__ == "__main__":
    unittest.main()
