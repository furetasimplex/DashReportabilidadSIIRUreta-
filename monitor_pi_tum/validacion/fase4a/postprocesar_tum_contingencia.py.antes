"""Planifica efectos DEV de un batch TUM; solo apilado necesita reproceso.

Uso: python -m monitor_pi_tum.postprocesar_tum_contingencia --batch-id 150 [--commit]
"""
import argparse
from dataclasses import dataclass
from datetime import date, timedelta

from sqlalchemy import text

from . import db


BATCH = '[DEV_SIIR].[hidro].[import_batch]'
HISTORY = '[DEV_SIIR].[hidro].[import_row_history]'
ESTADO = 'inventar_SpcHidr.v_contingencia_pi_estado_turno_test'
APILADO = 'inventar_SpcHidr.Control_Apilado_TMH_v2_test'
TEMPLATE = 'informe_tum_seca'
TEMPLATES = frozenset(('informe_tum_seca', 'informe_tum_srr', 'informe_tum_ripios'))
DATASET = 'informe_tum_totalizadores_turno'
EQUIPOS = frozenset(db.EQUIPOS)
APILADO_EQUIPOS = frozenset(('PRINCIPAL_CV008', 'PRINCIPAL_CV108'))


@dataclass(frozen=True)
class Plan:
    batch_id: int
    estado: str
    template: str
    cambios: int
    periodos: tuple
    bajo: tuple
    fuera: tuple
    fechas: tuple
    cambios_equipo: tuple = ()
    bajo_equipo: tuple = ()


def agrupar_fechas(fechas):
    """Forma bloques inclusivos sin incorporar fechas ajenas al plan."""
    bloques = []
    for dia in sorted(set(fechas)):
        if bloques and dia == bloques[-1][1] + timedelta(days=1):
            bloques[-1] = (bloques[-1][0], dia)
        else:
            bloques.append((dia, dia))
    return tuple(bloques)


def planificar(conn, batch_id):
    batch = conn.execute(text(f'''SELECT id, estado, template_code FROM {BATCH}
        WHERE id=:batch_id'''), {'batch_id':batch_id}).mappings().first()
    if not batch:
        raise ValueError(f'Batch {batch_id} inexistente en DEV_SIIR.hidro.import_batch.')
    estado, template = batch['estado'], batch['template_code']
    if estado != 'committed':
        raise ValueError(f'Batch {batch_id} no está committed (estado: {estado}).')
    if template not in TEMPLATES:
        return Plan(batch_id,estado,template,0,(),(),(),())

    # after_payload_json distingue INSERT/UPDATE de una eventual eliminación.
    rows = conn.execute(text(f'''SELECT
            JSON_VALUE(business_key_json,'$.fecha_operacional') AS fecha_operacional,
            JSON_VALUE(business_key_json,'$.turno') AS turno,
            JSON_VALUE(business_key_json,'$.equipo_codigo') AS equipo_codigo
        FROM {HISTORY}
        WHERE batch_id=:batch_id AND template_code=:template
          AND dataset_name=:dataset AND after_payload_json IS NOT NULL
          AND JSON_VALUE(business_key_json,'$.equipo_codigo') IN
              ('CHANCADOR_CV006','PRINCIPAL_CV008','PRINCIPAL_CV108',
               'SRR_CV001','SRR_CV002','SRR_CV003','RIPIOS_CV025')'''),
        {'batch_id':batch_id,'template':template,'dataset':DATASET}).mappings().all()
    periodos = set()
    cambios_equipo = set()
    for row in rows:
        if row['equipo_codigo'] not in EQUIPOS or row['turno'] not in ('A','B'):
            raise ValueError('History TUM contiene equipo o turno inválido.')
        try:
            dia = date.fromisoformat(row['fecha_operacional'])
        except (TypeError, ValueError):
            raise ValueError('History TUM contiene fecha operacional inválida.') from None
        periodos.add((dia,row['turno']))
        cambios_equipo.add((dia,row['turno'],row['equipo_codigo']))
    bajo, fuera = [], []
    for dia, turno in sorted(periodos):
        activa = conn.execute(text(f'''SELECT contingencia_pi_activa FROM {ESTADO}
            WHERE fecha_operacional=:fecha AND turno=:turno'''),
            {'fecha':dia,'turno':turno}).scalar_one_or_none()
        (bajo if activa else fuera).append((dia,turno))
    bajo_equipo = tuple(sorted(c for c in cambios_equipo if c[:2] in bajo))
    return Plan(batch_id,estado,template,len(rows),tuple(sorted(periodos)),
                tuple(bajo),tuple(fuera),
                tuple(sorted({dia for dia,_,equipo in bajo_equipo if equipo in APILADO_EQUIPOS})),
                tuple(sorted(cambios_equipo)),bajo_equipo)


def verificar_resultado(conn, plan):
    """Lectura posterior; PENDIENTE_TUM es un resultado válido."""
    resueltos = []
    for dia, turno in plan.bajo:
        rows = conn.execute(text(f'''SELECT equipo_codigo, fuente_resuelta,
            valor_final_resuelto FROM {db.RESOLVEDOR}
            WHERE fecha_operacional=:fecha AND turno=:turno
              AND equipo_codigo IN ('PRINCIPAL_CV008','PRINCIPAL_CV108')'''),
            {'fecha':dia,'turno':turno}).mappings().all()
        resueltos.extend((dia,turno,r['equipo_codigo'],r['fuente_resuelta']) for r in rows)
    apilados = []
    for dia in plan.fechas:
        row = conn.execute(text(f'''SELECT Fecha, TMH_CV008_A, TMH_CV108_A,
            TMH_Apilado_Total_A, TMH_CV008_B, TMH_CV108_B,
            TMH_Apilado_Total_B, TMH_Apilado_Total_Dia, Fecha_Calculo
            FROM {APILADO} WHERE Fecha=:fecha'''), {'fecha':dia}).mappings().first()
        apilados.append((dia, row is not None))
    return resueltos, apilados


def ejecutar(batch_id, commit=False, engine=None):
    engine = engine or db._engine_dev()
    if commit:
        reproceso_iniciado = False
        try:
            with engine.begin() as conn:
                db._assert_dev_connection(conn)
                plan = planificar(conn,batch_id)
                for inicio, fin in agrupar_fechas(plan.fechas):
                    reproceso_iniciado = True
                    db.reprocesar_apilado(conn,inicio,fin)
                resueltos, apilados = verificar_resultado(conn,plan) if plan.fechas else ([],[])
            return plan,resueltos,apilados
        except Exception:
            if reproceso_iniciado:
                print('Informe TUM permanece cargado. Reproceso PI/TUM no aplicado y puede reintentarse.')
            raise
    with engine.connect() as conn:
        db._assert_dev_connection(conn)
        return planificar(conn,batch_id),[],[]


def imprimir(plan, commit, resueltos, apilados):
    print(f'Batch: {plan.batch_id}\nEstado batch: {plan.estado}\nTemplate: {plan.template}')
    if plan.template not in TEMPLATES:
        print('Template fuera del alcance PI/TUM. No se reprocesó.')
        return
    print(f'Cambios de las siete señales encontrados: {plan.cambios}')
    if not plan.cambios:
        print('Batch sin cambios TUM relevantes para PI/TUM.')
    for titulo, periodos in [('Períodos modificados',plan.periodos),
                              ('Bajo contingencia',plan.bajo),('Fuera de contingencia',plan.fuera)]:
        print(f'{titulo}:')
        for dia, turno in periodos:
            print(f'  {dia:%d-%m-%Y} {turno}')
    print('Acciones downstream por señal:')
    for dia, turno, equipo in plan.bajo_equipo:
        accion = 'reproceso apilado' if equipo in APILADO_EQUIPOS else 'consumidor dinámico; sin reproceso'
        print(f'  {dia:%d-%m-%Y} {turno} {equipo}: {accion}')
    print('Fechas a reprocesar:')
    for dia in plan.fechas:
        print(f'  {dia:%d-%m-%Y}')
    if commit:
        print(f'COMMIT. Bloques reprocesados: {len(agrupar_fechas(plan.fechas))}')
        print(f'Resoluciones consultadas: {len(resueltos)}; filas de apilado presentes: '
              f'{sum(presente for _,presente in apilados)}/{len(apilados)}')
        for dia, turno, equipo, fuente in resueltos:
            print(f'  {dia:%d-%m-%Y} {turno} {equipo}: {fuente}')
    else:
        print('DRY-RUN. No se modificó apilado.')


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--batch-id',type=int,required=True)
    parser.add_argument('--commit',action='store_true')
    args = parser.parse_args(argv)
    if args.batch_id <= 0:
        parser.error('--batch-id debe ser positivo')
    plan, resueltos, apilados = ejecutar(args.batch_id,args.commit)
    imprimir(plan,args.commit,resueltos,apilados)


if __name__ == '__main__':
    main()
