ENTORNO=3
SQLSERVER_ENGINE=mssql
SQLSERVER_NAME=DEV_SIIR
SQLSERVER_HOST=127.0.0.1
SQLSERVER_PORT=1433
SQLSERVER_USER=sa
SQLSERVER_PASSWORD=cambiar
SQLSERVER_DRIVER=ODBC Driver 17 for SQL Server
SQLSERVER_DATABASE=inventar_SpcHidr
SQLSERVER_DB=inventar_SpcHidr
# SQLSERVER_DB=inventar_SpcHidr_PROD   # misma forma; schemas inventar_SpcHidr/reclamo viven DENTRO

# --- Auth (login Dash) ---
# Puede ser OTRA base en el mismo servidor (no es SQLSERVER_DB).
SECRET_KEY=cambiar-por-secreto-largo
LOGIN_DATABASE=DEV_SIIR.dbo.auth_user
# LOGIN_DATABASE=PROD_SIIR.dbo.auth_user

# Produccion: activa guardas estrictas no deshabilitables al arrancar.
# ENVIRONMENT=production
# SQLSERVER_DB=inventar_SpcHidr_PROD
# LOGIN_DATABASE=PROD_SIIR.dbo.auth_user
# BALANCE_RECON_DATABASE=PROD_SIIR

# --- App ---
PORT=8065
# PDF_ENGINE=python   # o libreoffice (legacy)

# --- Chequeo SQL al arranque (main/wsgi) ---
# DB_STARTUP_CHECK=1          # 0 para omitir
# DB_STARTUP_CHECK_STRICT=0   # 1 aborta si falta tabla/SP/vista/deps
# HIDRO_SIIR_DB=PROD_SIIR     # opcional: fuerza base hidro (DEV_SIIR|PROD_SIIR)
#   Por defecto: inventar_SpcHidr_PROD -> PROD_SIIR; inventar_SpcHidr -> DEV_SIIR
#   Verifica OBJECT_ID de hidro.* y que los modulos no apunten al SIIR del otro ambiente.
# DB_STARTUP_CHECK_BOTH_INVENTAR=1  # en DEV, tambien chequea inventar_SpcHidr_PROD
# DB_STARTUP_CHECK_PEER_STRICT=0    # 1: fallos del peer son requeridos (bloquean STRICT)
#   Nota: en PROD (inventar_SpcHidr_PROD) el peer NUNCA se revisa.

# --- Comparacion de modulos DEV vs PROD (scripts/sync_modules_dev_to_prod.py) ---
# Solo lo necesita ese script; la app nunca abre la conexion DEV.
# DEV_SQLSERVER_HOST=
# DEV_SQLSERVER_PORT=1433
# DEV_SQLSERVER_USER=
# DEV_SQLSERVER_PASSWORD=
# DEV_SQLSERVER_DB=inventar_SpcHidr

# --- LibreOffice PDF (solo si PDF_ENGINE=libreoffice) ---
# SAL_USE_VCLPLUGIN=gen
# LC_ALL=C.UTF-8
# LANG=C.UTF-8
