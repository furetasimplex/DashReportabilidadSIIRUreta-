<ShowPlanXML xmlns="http://schemas.microsoft.com/sqlserver/2004/07/showplan" Version="1.6" Build="14.0.1000.169"><BatchSequence><Batch><Statements><StmtSimple StatementText="WITH fechas AS (&#xa;    SELECT CAST(@P1 AS date) AS fecha&#xa;    UNION ALL SELECT DATEADD(day,1,fecha) FROM fechas WHERE fecha&lt;CAST(@P2 AS date)&#xa;    ) SELECT e.fecha,e.pad_id,e.parcela_id,e.numero_parcela,e.campana_id,e.numero_campana,e.estado_operacional,e.calidad_estado,e.tiene_dato_riego,e.riego_activo,e.tiene_dato_drenaje,e.drenaje_activo&#xa;    FROM fechas d CROSS APPLY inventar_SpcHidr.fn_estado_operacional_parcela_diario(d.fecha) e&#xa;    WHERE e.pad_id=@P3 AND e.parcela_id=@P4&#xa;    ORDER BY e.fecha OPTION (MAXRECURSION 32767)" StatementId="1" StatementCompId="1" StatementType="SELECT" RetrievedFromCache="true" StatementSubTreeCost="9.29993" StatementEstRows="11.5043" SecurityPolicyApplied="false" StatementOptmLevel="FULL" QueryHash="0xDC6F7FA1FB43E983" QueryPlanHash="0x75F647FB677DE496" StatementOptmEarlyAbortReason="TimeOut" CardinalityEstimationModelVersion="140"><StatementSetOptions QUOTED_IDENTIFIER="true" ARITHABORT="false" CONCAT_NULL_YIELDS_NULL="true" ANSI_NULLS="true" ANSI_PADDING="true" ANSI_WARNINGS="true" NUMERIC_ROUNDABORT="false"></StatementSetOptions><QueryPlan DegreeOfParallelism="1" MemoryGrant="11600" CachedPlanSize="1848" CompileTime="202" CompileCPU="202" CompileMemory="43016"><Warnings><PlanAffectingConvert ConvertIssue="Cardinality Estimate" Expression="CONVERT_IMPLICIT(varchar(12),[Expr1595],0)"></PlanAffectingConvert></Warnings><MemoryGrantInfo SerialRequiredMemory="10496" SerialDesiredMemory="11600" RequiredMemory="10496" DesiredMemory="11600" RequestedMemory="11600" GrantWaitTime="0" GrantedMemory="11600" MaxUsedMemory="1936" MaxQueryMemory="2275216"></MemoryGrantInfo><OptimizerHardwareDependentProperties EstimatedAvailableMemoryGrant="209654" EstimatedPagesCached="104827" EstimatedAvailableDegreeOfParallelism="4" MaxCompileMemory="5694816"></Optim